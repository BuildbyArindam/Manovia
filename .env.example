# Application environment (for example: development, test, production)
APP_ENV=

# Application signing secret; provide a secure value outside this template
SECRET_KEY=

# Database connection URL
DATABASE_URL=

# LLM provider selection (configured by the application)
LLM_PROVIDER=

# Anthropic API credentials and model configuration; keep secrets out of Git
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Local Ollama service base URL
OLLAMA_BASE_URL=

# Key used to encrypt sensitive fields; configure securely outside this template
FIELD_ENCRYPTION_KEY=

# Comma-separated browser origins allowed by the API
ALLOWED_ORIGINS=
