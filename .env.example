# Application environment
APP_ENV=

# Application signing secret (provide locally; never commit a real value).
# Signs JWT access/refresh tokens; required when APP_ENV=production.
SECRET_KEY=

# Database. SQLite for local work, PostgreSQL in production. The asyncio driver
# is chosen for you, so any of these forms is valid:
#   sqlite:///./manovia.db
#   sqlite:////absolute/path/manovia.db
#   postgresql+asyncpg://user:password@localhost:5432/manovia
#   postgres://user:password@host/database        (alias, from a PaaS)
# Required when APP_ENV=production.
DATABASE_URL=

# Log every SQL statement (never enable in production: statements carry data)
DB_ECHO=

# Field-level encryption key for the *_encrypted columns (message text, journal
# entries, mood notes). Required when APP_ENV=production, and required at all
# for anything that writes personal text. Generate a throwaway local one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# LLM provider selection
LLM_PROVIDER=

# Anthropic provider credentials and model selection
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Optional local Ollama service
OLLAMA_BASE_URL=

# Comma-separated browser origins allowed by the API
ALLOWED_ORIGINS=

# Logging

# Log level for the API (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=

# Authentication (Day 4). Every knob has a sane default; set only what differs.

# Password policy: length only, no composition rules (NIST SP 800-63B).
PASSWORD_MIN_LENGTH=
PASSWORD_MAX_LENGTH=

# Session lifetimes. Access tokens are short-lived; refresh tokens rotate.
JWT_ACCESS_MINUTES=
JWT_REFRESH_DAYS=

# Sliding-window request budgets per client IP. Strict on /api/v1/auth/*,
# moderate on the rest of /api/. Set RATE_LIMIT_ENABLED=false for load tests.
RATE_LIMIT_ENABLED=
RATE_LIMIT_AUTH_PER_MINUTE=
RATE_LIMIT_GLOBAL_PER_MINUTE=

# Account lockout after repeated failed logins. The lock doubles per further
# failure up to LOGIN_LOCKOUT_MAX_SECONDS and clears on a successful sign-in.
LOGIN_MAX_FAILURES=
LOGIN_LOCKOUT_SECONDS=
LOGIN_LOCKOUT_MAX_SECONDS=

# Emotion and sentiment analysis (Day 6)

# Which analyzer leads the chain: auto | hf | keyword | sentiment | fake.
# "auto" and "hf" put the Hugging Face model first; if it cannot load, a warning
# is logged and the lexicon analyzers answer instead. "fake" is for tests.
EMOTION_ANALYZER=

# Hugging Face model id (never a local path). Must be a multi-label emotion
# model whose labels app/services/nlp/hf.py can fold into the internal taxonomy.
# See docs/adr/0006-emotion-model.md for the choice, alternatives and licence.
EMOTION_MODEL_ID=

# Inference knobs. CPU-only by default; long input is truncated, never rejected.
EMOTION_DEVICE=
EMOTION_MAX_LENGTH=
EMOTION_BATCH_SIZE=

# In-memory LRU of results, keyed by a hash of the text (0 disables caching).
EMOTION_CACHE_SIZE=

# Graceful degradation. After EMOTION_FAILURE_THRESHOLD failures the model is
# skipped for EMOTION_COOLDOWN_SECONDS; if its latency average exceeds
# EMOTION_SLOW_MS the chain stops routing to it at all.
EMOTION_FAILURE_THRESHOLD=
EMOTION_COOLDOWN_SECONDS=
EMOTION_SLOW_MS=
