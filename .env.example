# Application environment (development | production). In development the
# Docker API container auto-migrates on start; production never does.
APP_ENV=

# --- Docker Compose (Day 7) ---
# docker compose reads ./.env for these; every one has a dev-only default, so
# the stack also starts with no .env at all. The api container's DATABASE_URL
# is always built from these three values for the in-network postgres.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Application signing secret (provide locally; never commit a real value).
# Signs JWT access/refresh tokens; required when APP_ENV=production.
SECRET_KEY=

# Database. SQLite for local work, PostgreSQL in production. The asyncio driver
# is chosen for you, so any of these forms is valid:
#   sqlite:///./manovia.db
#   sqlite:////absolute/path/manovia.db
#   postgresql+asyncpg://user:password@localhost:5432/manovia
#   postgres://user:password@host/database        (alias, from a PaaS)
# Required when APP_ENV=production.
DATABASE_URL=

# Log every SQL statement (never enable in production: statements carry data)
DB_ECHO=

# Field-level master encryption key (KEK) for the *_encrypted columns and
# per-user AES-256-GCM data keys (Day 3 & Day 17). Required when
# APP_ENV=production, and required at all for anything that writes personal
# text. Accepts either a bare 32-byte base64url key (uses FIELD_ENCRYPTION_KEY_ID)
# or a comma-separated keyring "<active_id>:<active_b64>,<old_id>:<old_b64>"
# during key rotation (see scripts/rotate_encryption_keys.py).
# Generate a throwaway local one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
FIELD_ENCRYPTION_KEY_ID=v1
FIELD_ENCRYPTION_PREVIOUS_KEYS=

# LLM provider selection (Day 10). One of: anthropic | ollama | fake.
#   anthropic -> Anthropic first, local Ollama second, canned reply last
#   ollama    -> local Ollama first, canned reply last
#   fake      -> the offline, deterministic double used by the test suite
# The chain ALWAYS ends at a canned supportive reply, so an unset key, a dead
# provider or a spent deadline degrades instead of returning a 500.
LLM_PROVIDER=

# Only used with LLM_PROVIDER=fake: a deliberate pause (milliseconds) before
# the first token. Leave at 0 for unit tests; end-to-end browser runs set it to
# a few hundred so the transient "Manovia is typing" state is observable
# rather than raced. Never set it with a real provider (it does nothing there).
LLM_FAKE_LATENCY_MS=0

# Anthropic provider credentials and model selection.
# No model id is hard-coded anywhere in the code: with ANTHROPIC_MODEL unset the
# provider reports "not configured" and the chain falls through. Set the model
# you have access to, for example:
#   ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Optional local Ollama service (the local fallback link).
# Defaults to http://localhost:11434 when unset. OLLAMA_MODEL is optional: if
# it is empty the provider asks the running server what it has (/api/tags).
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# --- LLM resilience, budget and privacy knobs (Day 10) ---
# All optional; the defaults below are what the code uses when unset.

# Hard wall-clock budget for one provider, across ALL of its retry attempts.
# When it is spent the chain moves to the next link.
LLM_TIMEOUT_SECONDS=15.0

# Retry: one try plus (LLM_MAX_ATTEMPTS - 1) retries, exponential backoff with
# full jitter (delay drawn from [0, min(LLM_RETRY_MAX_SECONDS, base * 2^n)]).
LLM_MAX_ATTEMPTS=3
LLM_RETRY_BASE_SECONDS=0.4
LLM_RETRY_MAX_SECONDS=8.0

# Circuit breaker: after this many consecutive failures a provider is skipped
# for LLM_CIRCUIT_COOLDOWN_SECONDS, then one probe is allowed through.
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_COOLDOWN_SECONDS=60.0

# Generation defaults. LLM_MAX_TOKENS is also the per-reply cost ceiling.
LLM_MAX_TOKENS=400
LLM_TEMPERATURE=0.7

# Input guard. Long messages are truncated at a word boundary (never rejected);
# the conversation window keeps the most recent turns that fit the token budget
# and never drops the newest user message. The token estimate is 4 chars/token.
LLM_MAX_INPUT_CHARS=8000
LLM_WINDOW_TURNS=12
LLM_WINDOW_TOKENS=3000

# Which versioned prompt file under backend/app/content/prompts/ to load.
# The file name IS the version (system_v1.md -> system_v1). See
# backend/app/content/prompts/CHANGELOG.md before changing it.
LLM_PROMPT_VERSION=system_v3

# PII redaction before anything leaves for a provider (emails, phone numbers,
# Aadhaar/PAN/SSN-like ids, card-like numbers, URLs). Names stay OFF by
# default: LLM_REDACT_NAMES=true needs an NER model (pip install -e ".[ner]"),
# and a name detector that fires on common Indian given names is worse than
# none. Never disable LLM_REDACT_PII in production.
LLM_REDACT_PII=true
LLM_REDACT_NAMES=false

# Comma-separated browser origins allowed by the API
ALLOWED_ORIGINS=

# --- Observability (Day 27) ---

# The Prometheus scrape endpoint at /metrics. Labels are route templates and
# closed-set categories only — never user text or identifiers. Turn it off
# only when a sidecar publishes metrics instead. Default: on.
METRICS_ENABLED=

# Sentry error reporting. Empty = disabled (the app never contacts the
# network). Every event passes a privacy scrubber before it leaves: request
# bodies, query strings and cookies are dropped, headers are allowlisted, and
# free text (exception messages, extras) is PII-redacted. There is no flag
# that turns the scrubbing off. Set via the platform secret store (fly
# secrets set / Netlify env), never in the repo.
SENTRY_DSN=

# Sentry environment label. Blank = APP_ENV.
SENTRY_ENVIRONMENT=

# Fraction (0.0–1.0) of requests traced for performance. Default 0: tracing
# is a deliberate decision, not a default.
SENTRY_TRACES_SAMPLE_RATE=

# --- Feature flags for risky features (Day 27) ---

# The evals' optional 4-axis LLM-as-judge (evals/prompts/response_judge_v1.md).
# Advisory-only and uncalibrated against human ratings (ADR 0024). Without it,
# `--with-judge` / `--judge` exit with code 2 and an explanation. Default: off.
FEATURE_LLM_JUDGE=

# Safety-ML threshold changes in production are refused unless this is true:
# SAFETY_ML_MIN_CONFIDENCE / _CRISIS_MASS_FLOOR / _SUSPICION_FLOOR must stay at
# the shipped operating point (0.70 / 0.30 / 0.25) unless someone consciously
# accepts the change (and records it in PROGRESS.md). Development and tests
# are unrestricted — tuning happens there. Default: off.
FEATURE_ML_THRESHOLDS_UNLOCKED=

# Logging

# Log level for the API (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=

# Authentication (Day 4). Every knob has a sane default; set only what differs.

# Password policy: length only, no composition rules (NIST SP 800-63B).
PASSWORD_MIN_LENGTH=
PASSWORD_MAX_LENGTH=

# Session lifetimes. Access tokens are short-lived; refresh tokens rotate.
JWT_ACCESS_MINUTES=
JWT_REFRESH_DAYS=

# Sliding-window request budgets per client IP. Strict on /api/v1/auth/*,
# moderate on the rest of /api/. Set RATE_LIMIT_ENABLED=false for load tests.
RATE_LIMIT_ENABLED=
RATE_LIMIT_AUTH_PER_MINUTE=
RATE_LIMIT_GLOBAL_PER_MINUTE=

# Account lockout after repeated failed logins. The lock doubles per further
# failure up to LOGIN_LOCKOUT_MAX_SECONDS and clears on a successful sign-in.
LOGIN_MAX_FAILURES=
LOGIN_LOCKOUT_SECONDS=
LOGIN_LOCKOUT_MAX_SECONDS=

# Emotion and sentiment analysis (Day 6)

# Which analyzer leads the chain: auto | hf | baseline | trained | keyword |
# sentiment | fake.
#   auto / hf / baseline - the off-the-shelf Hugging Face checkpoint in
#       EMOTION_MODEL_ID ("baseline" names it explicitly: it is the Day-6
#       model, and it is what a report compares a fine-tuned model against);
#   trained  - the LoRA model from Day 32, packaged in EMOTION_TRAINED_DIR;
#   keyword / sentiment - the lexicon analyzers;
#   fake     - deterministic, for tests.
# Whatever the choice, if the model cannot load a warning is logged once and the
# lexicon analyzers answer instead. Deleting a model directory is a supported
# state, never a startup failure (ADR 0006, ADR 0032).
EMOTION_ANALYZER=

# Hugging Face model id (never a local path). Must be a multi-label emotion
# model whose labels app/services/nlp/hf.py can fold into the internal taxonomy.
# See docs/adr/0006-emotion-model.md for the choice, alternatives and licence.
EMOTION_MODEL_ID=

# Where a packaged fine-tuned model lives: a directory with model/, tokenizer/,
# thresholds.json, manifest.json and MODEL_CARD.md (the layout the Day-32 ML
# package writes; see docs/adr/0032-emotion-lora-finetune.md). Required when
# EMOTION_ANALYZER=trained. A relative path resolves against the repository
# root. The weights are never committed — copy or download the directory onto
# the host, and the chain falls back to the lexicon if it is missing.
EMOTION_TRAINED_DIR=

# Inference knobs. CPU-only by default; long input is truncated, never rejected.
EMOTION_DEVICE=
EMOTION_MAX_LENGTH=
EMOTION_BATCH_SIZE=

# In-memory LRU of results, keyed by a hash of the text (0 disables caching).
EMOTION_CACHE_SIZE=

# Graceful degradation. After EMOTION_FAILURE_THRESHOLD failures the model is
# skipped for EMOTION_COOLDOWN_SECONDS; if its latency average exceeds
# EMOTION_SLOW_MS the chain stops routing to it at all.
EMOTION_FAILURE_THRESHOLD=
EMOTION_COOLDOWN_SECONDS=
EMOTION_SLOW_MS=

# Safety ML ensemble (Day 9). All knobs have shipped defaults; set only what
# differs. The classifier is an additive backstop behind the Day 8 rules
# engine (ADR 0009): it can raise an assessment, never lower one.

# Master switch for the ML backstop. false = the exact Day 8 rules-only
# pipeline (also the automatic behaviour if the artifact is missing).
SAFETY_ML_ENABLED=

# Ensemble thresholds (see docs/safety-design.md §12.3). Chosen by grid search
# on the dev split only; the test split is frozen by hash.
SAFETY_ML_MIN_CONFIDENCE=
SAFETY_ML_CRISIS_MASS_FLOOR=
SAFETY_ML_SUSPICION_FLOOR=

# Alternative artifact directory (defaults to the committed crisis_v1).
SAFETY_ML_ARTIFACT_DIR=

# Which classifier the ensemble uses (Day 33): `baseline` (the Day-9 TF-IDF
# model, the default and what every pre-Day-33 deployment behaves like) or
# `trained` (the cost-sensitive LoRA model from ml/configs/safety_lora_xlmr.yaml,
# packaged with a temperature, a conformal quantile and an abstention policy).
# `trained` needs transformers+torch installed and the artifact directory below
# populated; if either is missing the factory falls back to `baseline` and says
# so in the classifier version — it never falls back to "no classifier".
SAFETY_ML=

# Where the Day-33 trained artifact lives (defaults to
# backend/app/ml_artifacts/safety_trained/). Never committed to Git: the weights
# are produced by the GPU run in ml/notebooks/colab_safety_lora.ipynb.
SAFETY_ML_TRAINED_ARTIFACT_DIR=

# Chat orchestrator (Day 11). Blank = shipped default.

# Longest single message accepted, in characters (default 4000). Longer is a
# 422, never a silent truncation.
CHAT_MAX_MESSAGE_CHARS=

# Messages per minute per signed-in user (default 30). Ignored when
# RATE_LIMIT_ENABLED=false.
CHAT_RATE_LIMIT_PER_MINUTE=

# Data exports per signed-in user per hour (default 10). An export decrypts
# everything the person owns; over the budget is a 429 with Retry-After.
# Ignored when RATE_LIMIT_ENABLED=false. (Day 29)
PRIVACY_EXPORT_PER_HOUR=

# Prior messages carried into the prompt (default 10).
CHAT_HISTORY_TURNS=

# Sessions the user did not choose to save live in process memory only.
# Inactivity TTL in seconds (default 1800 = 30 minutes), a cap on live
# sessions, and a cap on turns kept per session.
CHAT_EPHEMERAL_TTL_SECONDS=
CHAT_EPHEMERAL_MAX_SESSIONS=
CHAT_EPHEMERAL_MAX_TURNS=

# --- Knowledge base and retrieval (Day 13). Blank = shipped default. ---

# Retrieval augments the chat prompt with curated self-help passages from
# backend/app/content/knowledge/. With RAG_ENABLED=false (or before the first
# `make ingest`) the pipeline answers without reference material.
RAG_ENABLED=

# Which embedder builds and reads the vector store:
#   auto                  sentence-transformers when its package imports,
#                         otherwise the offline corpus-fitted TF-IDF (default)
#   sentence_transformers the multilingual checkpoint in RAG_EMBEDDING_MODEL_ID
#   tfidf                 offline: TF-IDF fitted on the corpus at ingest
#   hashing               offline, fit-free; tests and escape hatch only
# The store records which embedder built it (data/rag/embedder.json) and the
# retrieval side loads that, so changing this after an ingest requires a
# re-ingest (which is automatic: the next `make ingest` rebuilds).
RAG_EMBEDDER=

# The embedding checkpoint. Must be multilingual (the corpus and the chat
# surface carry en, hi and bn). Default:
#   paraphrase-multilingual-MiniLM-L12-v2
# Downloaded from Hugging Face on first use; the sandbox cannot reach the Hub,
# so offline environments fall back to tfidf.
RAG_EMBEDDING_MODEL_ID=

# Vector size for the hashing embedder only (default 384).
RAG_EMBEDDING_DIM=

# Where the FAISS index, sidecars and (for tfidf) the fitted vectorizer live.
# Relative to the working directory; backend/data/rag for `make ingest` /
# `make dev`. Gitignored: rebuildable from the corpus with `make ingest`.
RAG_PERSIST_DIR=

# Minimum cosine similarity for a chunk to be served (default 0 = use the
# recommended floor for the active embedding space: ~0.20 for tfidf on this
# corpus, ~0.35 for sentence-transformers). Below the floor nothing is
# retrieved — an empty result is preferred to an irrelevant passage.
RAG_MIN_SIMILARITY=

# Chunking, in whitespace words (default 220 target / 50 overlap). Rationale
# in app/services/rag/chunking.py: tokenizers disagree 2-3x across scripts.
RAG_CHUNK_WORDS=
RAG_CHUNK_OVERLAP_WORDS=

# Chunks retrieved per chat turn (default 3, max 10). They appear in the
# prompt as labelled reference material and in reply metadata as
# retrieved_ids / retrieved_docs for the UI's "Learn more" cards.
RAG_RETRIEVAL_LIMIT=
