{"id": "val-en-neutral-05", "labels": ["neutral"], "lang": "en", "licence": "MIT (this repository)", "source": "handwritten-val-v1", "text": "my cousin works in a bank in Pune"}
{"id": "val-en-neutral-06", "labels": ["neutral"], "lang": "en", "licence": "MIT (this repository)", "source": "handwritten-val-v1", "text": "there is a new bus stop near the market"}
{"id": "val-hi-joy-01", "labels": ["joy"], "lang": "hi", "licence": "MIT (this repository)", "source": "handwritten-val-v1", "text": "आज पहली बार अपने हाथ से बनी चाय सबको पसंद आई"}
