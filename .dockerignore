# Build context for both Dockerfiles. Keep secrets, VCS data, caches and
# build artefacts out of images — smaller context, faster builds, no leaks.
.git
.github

# Never bake environment files (secrets!) into an image.
.env
.env.*
!.env.example

# Python
.venv/
venv/
**/__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
coverage.xml
htmlcov/
*.egg-info/

# Node / frontend
**/node_modules/
frontend/dist/

# Local databases and model caches
*.db
*.sqlite
*.sqlite3
.cache/

# OS / editors
.DS_Store
.idea/
.vscode/
