{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manovia.app/schemas/helplines.schema.json",
  "title": "Manovia helpline content (backend/app/content/helplines.json)",
  "description": "The contract for the only file that may carry crisis contact details. Every entry must be traceable to a source (source_url) and dated (last_verified); anything that could not be verified from an official source must say so with needs_verification=true and a verification_note. AGENTS.md safety rule 6.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "last_verified", "source", "disclaimer", "regions", "resources"],
  "properties": {
    "version": {
      "description": "Bumped whenever the shape of this file changes.",
      "const": 2
    },
    "last_verified": {
      "description": "ISO date the whole file was last reviewed by a person.",
      "$ref": "#/$defs/iso_date"
    },
    "source": {
      "type": "string",
      "minLength": 20,
      "maxLength": 1000
    },
    "disclaimer": {
      "type": "string",
      "minLength": 10,
      "maxLength": 600
    },
    "regions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/region_code" },
      "description": "Every region served. DEFAULT is the fallback set and must be present."
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/resource" }
    }
  },
  "$defs": {
    "iso_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "region_code": {
      "type": "string",
      "pattern": "^([A-Z]{2}|DEFAULT)$"
    },
    "dialable_number": {
      "type": "string",
      "pattern": "^[0-9+()\\-.\\s]{3,32}$",
      "description": "Only characters a person can actually dial or text."
    },
    "https_url": {
      "type": "string",
      "pattern": "^https://\\S+$"
    },
    "contact_type": {
      "enum": ["call", "text", "chat", "web"],
      "description": "How the entry is reached. 'web' is the documented extension for directory-only entries that publish no number."
    },
    "resource_kind": {
      "enum": ["emergency", "crisis_line", "text_line", "directory"]
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "region",
        "kind",
        "name",
        "number",
        "type",
        "hours",
        "languages",
        "description",
        "url",
        "source_url",
        "last_verified",
        "needs_verification",
        "priority"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 3, "maxLength": 64, "pattern": "^[a-z0-9-]+$" },
        "region": { "$ref": "#/$defs/region_code" },
        "kind": { "$ref": "#/$defs/resource_kind" },
        "name": { "type": "string", "minLength": 2, "maxLength": 160 },
        "number": {
          "oneOf": [{ "$ref": "#/$defs/dialable_number" }, { "type": "null" }]
        },
        "type": { "$ref": "#/$defs/contact_type" },
        "text_keyword": {
          "description": "The word to send first on a text line (e.g. HOME, SHOUT, CONNECT).",
          "type": ["string", "null"],
          "maxLength": 32
        },
        "instructions": { "type": ["string", "null"], "maxLength": 400 },
        "hours": { "type": "string", "minLength": 1, "maxLength": 80 },
        "languages": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "maxLength": 48 }
        },
        "audience": { "type": ["string", "null"], "maxLength": 120 },
        "description": { "type": "string", "minLength": 10, "maxLength": 500 },
        "url": { "oneOf": [{ "$ref": "#/$defs/https_url" }, { "type": "null" }] },
        "source_url": {
          "description": "Where the number, hours and languages were verified. Required, never null.",
          "$ref": "#/$defs/https_url"
        },
        "last_verified": { "$ref": "#/$defs/iso_date" },
        "needs_verification": {
          "type": "boolean",
          "description": "true when any field could not be confirmed against an official source."
        },
        "verification_note": { "type": ["string", "null"], "maxLength": 600 },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Lower sorts first within a region; the emergency number is always lowest."
        }
      },
      "allOf": [
        {
          "$comment": "A directory entry publishes no number, so it must be type 'web'.",
          "if": { "properties": { "kind": { "const": "directory" } }, "required": ["kind"] },
          "then": { "properties": { "type": { "const": "web" }, "number": { "type": "null" } } }
        },
        {
          "$comment": "Anything else must be reachable: a number or a website.",
          "if": { "properties": { "kind": { "enum": ["emergency", "crisis_line", "text_line"] } }, "required": ["kind"] },
          "then": {
            "anyOf": [
              { "properties": { "number": { "$ref": "#/$defs/dialable_number" } }, "required": ["number"] },
              { "properties": { "url": { "$ref": "#/$defs/https_url" } }, "required": ["url"] }
            ]
          }
        },
        {
          "$comment": "An emergency number and a text line must always carry a number.",
          "if": {
            "properties": { "kind": { "enum": ["emergency", "text_line"] } },
            "required": ["kind"]
          },
          "then": { "properties": { "number": { "$ref": "#/$defs/dialable_number" } }, "required": ["number"] }
        },
        {
          "$comment": "A text line is reached by text, an emergency number by call.",
          "if": { "properties": { "kind": { "const": "text_line" } }, "required": ["kind"] },
          "then": { "properties": { "type": { "const": "text" } } }
        },
        {
          "$comment": "Something flagged as unverified must explain why.",
          "if": { "properties": { "needs_verification": { "const": true } }, "required": ["needs_verification"] },
          "then": { "properties": { "verification_note": { "type": "string", "minLength": 20 } }, "required": ["verification_note"] }
        }
      ]
    }
  }
}
